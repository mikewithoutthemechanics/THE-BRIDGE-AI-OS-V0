{
  "id": "tier-change",
  "name": "Change user tier",
  "description": "Change any user's tier (free / pro / enterprise / super_admin). Records prev+next in audit log.",
  "category": "identity",
  "required_tier": "super_admin",
  "required_capability": "settings.write.user_override",
  "confirmation_required": true,
  "params": [
    { "name": "email", "type": "email", "required": true, "label": "Target user email" },
    { "name": "tier",  "type": "string", "required": true, "values": ["free", "pro", "enterprise", "super_admin"] }
  ],
  "steps": [
    { "type": "confirm",   "message": "Change {email} to tier {tier}?" },
    { "type": "http_post", "path": "/settings/tier", "body": { "email": "{email}", "tier": "{tier}" } }
  ],
  "estimated_duration_s": 1,
  "audit": true,
  "audit_action": "tier_change"
}
