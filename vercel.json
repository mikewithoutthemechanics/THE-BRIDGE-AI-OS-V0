{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "public/**",
      "use": "static"
    }
  ],
  "routes": [
    { "src": "/terminal",      "destination": "/terminal.html" },
    { "src": "/wallet",       "destination": "/wallet.html" },
    { "src": "/avatar",       "destination": "/avatar.html" },
    { "src": "/outputs",      "destination": "/outputs.html" },
    { "src": "/projects",     "destination": "/projects.html" },
    { "src": "/(.*)",         "destination": "/$1" }
  ]
}