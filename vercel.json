{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "shared/**,port-assignments.json,agents/**,certs/**,lib/**,engine/**,api/hitl.js,api/pipeline.js,api/crm/**,api/cron/**,api/esim/**,api/pbx/**,api/corporate/**,public/claude-partner.html"
    }
  },
  "crons": [
    { "path": "/api/agents/auto",        "schedule": "0 */6 * * *" },
    { "path": "/api/infra/auto",         "schedule": "0 */1 * * *" },
    { "path": "/api/banks/compound",     "schedule": "0 0 * * *"   },
    { "path": "/api/treasury/reconcile", "schedule": "0 */3 * * *" },
    { "path": "/api/economy/run-cycle",  "schedule": "*/5 * * * *" },
    { "path": "/api/neurolink/cron/tick",         "schedule": "*/1 * * * *" },
    { "path": "/api/neurolink/cron/orchestrator", "schedule": "*/1 * * * *" },
    { "path": "/api/neurolink/cron/stream-flush", "schedule": "*/1 * * * *" },
    { "path": "/api/neurolink/cron/graph-update", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/distribute-rewards",     "schedule": "0 * * * *" },
    { "path": "/api/cron/auto-send",              "schedule": "0 9,10,14,15 * * 1-5" },
    { "path": "/api/orch/tick",                   "schedule": "*/15 * * * *" },
    { "path": "/api/cron/provision-heal",         "schedule": "0 */4 * * *" },
    { "path": "/api/cron/corporate-engine",       "schedule": "*/1 * * * *" }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "ehsa.ai-os.co.za" }], "destination": "/ehsa", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "hospitalinabox.ai-os.co.za" }], "destination": "/hospital", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "aid.ai-os.co.za" }], "destination": "/aid", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "rootedearth.ai-os.co.za" }], "destination": "/rootedearth", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "aurora.ai-os.co.za" }], "destination": "/aurora", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "ubi.ai-os.co.za" }], "destination": "/ubi", "permanent": false }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
      { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
    ]}
  ],
  "rewrites": [
    { "source": "/apps",          "destination": "/50-applications.html" },
    { "source": "/dashboard",     "destination": "/aoe-dashboard.html" },
    { "source": "/status",        "destination": "/system-status-dashboard.html" },
    { "source": "/terminal",      "destination": "/terminal.html" },
    { "source": "/wallet",        "destination": "/wallet.html" },
    { "source": "/avatar",        "destination": "/avatar.html" },
    { "source": "/marketplace",   "destination": "/marketplace.html" },
    { "source": "/outputs",        "destination": "/outputs.html" },
    { "source": "/projects",      "destination": "/projects.html" },
    { "source": "/api/:path*", "destination": "/api" }
  ]
}