# Preview Deployment Configuration

# This file configures preview deployments for PRs
# Each PR gets a live preview environment to validate changes

# For Vercel (recommended for Next.js/React apps)
[build]
  command = "npm run build"
  publish = "build"

# For Netlify
[build.environment]
  NODE_VERSION = "18"

# Build command
[build]
  command = "npm run build && npm run export"

# Publish directory
[build]
  publish = "out"

# Redirect rules for SPA
[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200

# Environment variables for preview
[build.environment]
  PREVIEW_MODE = "true"
  PR_NUMBER = "$REVIEW_ID"