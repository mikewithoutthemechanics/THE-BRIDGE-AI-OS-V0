# Bridge Task Runner - Environment Template
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# ─── Server ───────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
DEMO_MODE=true
NETWORK_MODE=offline

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── PostgreSQL / Supabase ────────────────────────────────────────
# For local development, you can use SQLite (in-memory) if not set
DATABASE_URL=postgresql://user:password@localhost:5432/bridge
# Supabase (preferred for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ─── Authentication ───────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_HEX_CHARS
BRIDGE_INTERNAL_SECRET=CHANGE_ME_TO_32_RANDOM_HEX_CHARS

# ─── Superuser Configuration ─────────────────────────────────────
# Emails that have superuser/admin access
SUPERUSER_EMAILS=admin@your-domain.com,superadmin@your-domain.com

# ─── Email / Notifications ───────────────────────────────────────
SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_USER=admin@your-domain.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=admin@your-domain.com
SMTP_FROM_NAME=Bridge Task Runner

# ─── Payment Processing (optional, for monetization) ─────────────
# PayFast (South Africa)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=https://your-domain.com/payfast/notify
PAYFAST_RETURN_URL=https://your-domain.com/payment/success
PAYFAST_CANCEL_URL=https://your-domain.com/payment/cancel

# Stripe (Global)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # or live

# ─── AI / LLM Providers ───────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=

# ─── System Monitoring ────────────────────────────────────────────
# Sentry (error tracking)
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
JSON_LOGS=true

# ─── Redis (optional, for caching/queues) ─────────────────────────
REDIS_URL=redis://localhost:6379