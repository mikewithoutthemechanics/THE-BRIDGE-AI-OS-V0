# Environment variables for docker-compose.prod.yml
# Update these values BEFORE deploying to production

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_USER=bridge
DB_PASS=changeme-prod-password
POSTGRES_INITDB_ARGS=-c max_connections=200 -c shared_buffers=256MB -c effective_cache_size=1GB

# ============================================
# Redis Configuration
# ============================================
REDIS_PASS=changeme-redis-password
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-NOW
JWT_EXPIRY=7d

# ============================================
# Neo4j Configuration (Optional)
# ============================================
NEO4J_USER=neo4j
NEO4J_PASS=changeme-neo4j-password
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

# ============================================
# Supabase Integration (Optional - leave blank for offline mode)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ============================================
# Environment
# ============================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# Service URLs (internal networking)
# ============================================
GATEWAY_URL=http://gateway:8080
MAIN_SERVICE_URL=http://main-service:3000
BRAIN_SERVICE_URL=http://brain:8000
SVG_SERVICE_URL=http://svg-engine:7070

# ============================================
# Performance Tuning
# ============================================
NODE_OPTIONS=--max-old-space-size=2048
WORKER_THREADS=4
