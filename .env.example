# Bridge AI OS — Environment Variables Reference
# Copy to .env and fill in real values before deploying.
# Lines starting with # are comments. Do NOT commit .env to git.

# ============================================
# Core Runtime
# ============================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
BASE_URL=https://go.ai-os.co.za
PUBLIC_URL=https://go.ai-os.co.za
ALLOWED_ORIGINS=https://go.ai-os.co.za,https://bridge-ai-os.com

# ============================================
# Authentication & Sessions
# ============================================
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-different-from-jwt-secret
JWT_EXPIRY=7d
SESSION_SECRET=change-this-session-secret
AUTH_TOKEN_SECRET=change-this-auth-token-secret
AUTH_PORT=5001
DEV_LOGIN_SECRET=

# ============================================
# Supabase
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://bridge:changeme@localhost:5432/bridge
ECONOMY_DB_URL=postgresql://bridge:changeme@localhost:5432/economy
MCP_DATABASE_URL=postgresql://bridge:changeme@localhost:5432/bridge
DB_USER=bridge
DB_PASS=changeme-prod-password
POSTGRES_INITDB_ARGS=-c max_connections=200 -c shared_buffers=256MB -c effective_cache_size=1GB

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASS=changeme-redis-password
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================
# AI Providers
# ============================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=sk-or-...
KILO_API_KEY=
KILO_MODEL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# AI spend limits
LLM_PROVIDER_ORDER=anthropic,openrouter,openai
LLM_DAILY_CAP_USD=10
LLM_MONTHLY_CAP_USD=200
LLM_MAX_TOKENS=4096
AI_MONTHLY_BUDGET=200

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://go.ai-os.co.za/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://go.ai-os.co.za/auth/google/callback
GOOGLE_OAUTH_POST_LOGIN=/dashboard

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
GH_TOKEN=

# ============================================
# Payment Providers
# ============================================
# PayFast (ZAR)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
PAYFAST_RETURN_URL=https://go.ai-os.co.za/payment-success
PAYFAST_CANCEL_URL=https://go.ai-os.co.za/payment-cancel
PAYFAST_NOTIFY_URL=https://go.ai-os.co.za/api/webhooks/payfast
PAYFAST_VALIDATE_URL=https://www.payfast.co.za/eng/query/validate
PAYFAST_ENABLE_IP_ALLOWLIST=true
PAYFAST_IP_ALLOWLIST=

# Stripe
STRIPE_SECRET_KEY=sk_live_...

# PayPal
PAYPAL_CLIENT_ID=

# Paystack
PAYSTACK_SECRET_KEY=

# ============================================
# Email (Brevo / SMTP)
# ============================================
BREVO_SMTP_KEY=
BREVO_SMTP_USER=
BREVO_FROM=noreply@bridge-ai-os.com
BREVO_FROM_NAME=Bridge AI OS
FROM_EMAIL=noreply@bridge-ai-os.com
SMTP_FROM=noreply@bridge-ai-os.com
SMTP_FROM_NAME=Bridge AI OS
SMTP_BACKUP_USER=
SMTP_BACKUP_PASS=
GMAIL_USER=
GMAIL_APP_PASS=

# ============================================
# Notifications
# ============================================
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOKEN=
REVENUE_ALERT_WEBHOOK=

# ============================================
# Service Ports
# ============================================
GATEWAY_PORT=8082
GATEWAY_LISTEN_HOST=127.0.0.1
BRAIN_PORT=8000
BRAIN_HOST=127.0.0.1
ADMIN_PORT=9000
SVG_ENGINE_PORT=7070
TERMINAL_PROXY_PORT=5002
BILLING_PORT=
SUBSCRIPTION_PORT=
REVENUE_ENGINE_PORT=
OVERSEER_METRICS_PORT=9092
CONFIG_PORT=
OPS_DAEMON_PORT=
ADVISOR_PORT=
CONTAINERX_PORT=

# ============================================
# Internal Service URLs
# ============================================
GATEWAY_URL=http://127.0.0.1:8082
MAIN_SERVICE_URL=http://127.0.0.1:3000
BRAIN_SERVICE_URL=http://127.0.0.1:8000
SVG_SERVICE_URL=http://127.0.0.1:7070
BRIDGE_API_BASE=http://127.0.0.1:8000
BRIDGE_SERVICE_URL=http://127.0.0.1:3000
OVERSEER_URL=http://127.0.0.1:9091
L1_ORCHESTRATOR_URL=http://127.0.0.1:9001
L2_ORCHESTRATOR_URL=
L3_ORCHESTRATOR_URL=http://127.0.0.1:9003
AUTH_SVC=http://127.0.0.1:5001
REGISTRY_URL=http://127.0.0.1:3000
MCP_FILESYSTEM_URL=
MCP_GITHUB_URL=
MCP_SLACK_URL=
MCP_SEARCH_URL=

# Dual-VPS bridge (optional)
THIS_SIDE_BRAIN=http://127.0.0.1:8000
THIS_SIDE_GATEWAY=http://127.0.0.1:8082
THIS_SIDE_MAIN=http://127.0.0.1:3000
OTHER_SIDE_BRAIN=
OTHER_SIDE_GATEWAY=
OTHER_SIDE_MAIN=
SERVICE_SIDE=primary

# ============================================
# Security & Admin
# ============================================
ADMIN_TOKEN=change-this-admin-token
ADMIN_API_TOKEN=change-this-admin-api-token
ADMIN_ADDRESS=
BRIDGE_ADMIN_SECRET=change-this-bridge-admin-secret
BRIDGE_INTERNAL_SECRET=change-this-internal-secret
BRIDGE_VERIFY_SECRET=change-this-verify-secret
ORCHESTRA_ADMIN_TOKEN=change-this-orchestra-token
ORCHESTRA_SESSION_SECRET=change-this-orchestra-session
CFO_TOKEN=change-this-cfo-token
MCP_SECRET_KEY=change-this-mcp-secret
MCP_BEARER_TOKEN=change-this-mcp-bearer
TVM_SECRET=change-this-tvm-secret
WEBHOOK_SECRET=change-this-webhook-secret
CRON_SECRET=change-this-cron-secret
VERCEL_CRON_SECRET=change-this-vercel-cron
SECRETS_MASTER_KEY=change-this-secrets-master-key
AGENT_SALT=change-this-agent-salt
TOTP_ENCRYPTION_KEY=change-this-totp-key
KEYFORGE_EPOCH_SEC=1700000000
SIWE_SECRET=change-this-siwe-secret
BRIDGE_SIWE_JWT_SECRET=change-this-siwe-jwt-secret

# Orchestra settings
ORCHESTRA_ALLOW_IFRAME=false
ORCHESTRA_COOKIE_SECURE=true
ORCHESTRA_RATE_LIMIT=100

# ============================================
# Blockchain / Web3
# ============================================
BRDG_CONTRACT_ADDRESS=
STABLE_ADDRESS=
ASSET_ADDRESS=
TREASURY_ADDRESS=
DEPLOYER_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
ZEON_DEPLOYER_KEY=
LINEA_RPC_URL=https://rpc.linea.build
LINEASCAN_API_KEY=
GAS_BUMP_PCT=10
GAS_BUMP_MAX_GWEI=50
BRIDGE_SIWE_CHAIN_ID=59144
BRIDGE_SIWE_RPC_URL=https://rpc.linea.build
GENESIS_TGE_ISO=2025-01-01T00:00:00Z

# ============================================
# Overseer (Sovereign Authority Layer)
# ============================================
OVERSEER_ENABLED=true
OVERSEER_INTERVAL=30000
OVERSEER_STATE_PATH=./overseer/state.json
OVERSEER_LOG_PATH=./overseer/audit.log
ENABLE_OVERSEER_INTEGRATION=true

# ============================================
# Economy Engine
# ============================================
ENABLE_ECONOMY=true
BRIDGE_TICK_MS=60000
DAILY_ACTION_CAP=1000
BILLING_INTERVAL=monthly
WITHDRAWAL_COOLDOWN_MINUTES=1440
WITHDRAWAL_DAILY_LIMIT=50000
WITHDRAWAL_LARGE_THRESHOLD=10000
WITHDRAWAL_MIN_AMOUNT=10
COMMISSION_RATES={"default":0.05}
BANK_L1_MAX=10000
BANK_L2_MAX=100000

# ============================================
# Affiliate Program
# ============================================
AFFILIATE_COMMISSION_RATE=0.15
AFFILIATE_CLOUDFLARE_ID=
AFFILIATE_DO_ID=
AFFILIATE_ELEVENLABS_ID=
AFFILIATE_LUNO_ID=
AFFILIATE_WEBWAY_ID=

# ============================================
# WordPress Integration
# ============================================
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WP_BACKEND_URL=
WP_HOOK_SECRET=
WP_BRIDGE_AI_OS_URL=https://bridge-ai-os.com
WP_BRIDGE_AI_OS_USER=
WP_BRIDGE_AI_OS_APP_PASS=
WP_COM_URL=
WP_COM_USER=
WP_COM_APP_PASS=
WP_GATEWAY_URL=
WP_GATEWAY_USER=
WP_GATEWAY_APP_PASS=

# ============================================
# Notion Integration
# ============================================
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE=

# ============================================
# Vercel / Cloudflare
# ============================================
BLOB_READ_WRITE_TOKEN=
VERCEL_DEPLOYMENT_ID=
VERCEL=
DA_BASE_URL=
DA_USERNAME=
DA_LOGIN_KEY=

# ============================================
# Azure (optional)
# ============================================
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=

# ============================================
# NeuroLink / Emotiv (optional — BCI hardware)
# ============================================
NEUROLINK_ENABLED=false
NEUROLINK_DEVICE=
NEUROLINK_INTERVAL=100
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=

# ============================================
# Rate Limiting & Performance
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTO_KILL_MAX_REQUESTS=500
AUTO_KILL_WINDOW_MS=60000
AUTO_KILL_REFRESH_MS=5000
NODE_OPTIONS=--max-old-space-size=2048
WORKER_THREADS=4
GRAPH_MAX_BYTES=52428800
POLL_INTERVAL_MS=5000
HEALTH_INTERVAL=30000
RESCUE_COOLDOWN_MS=60000
CONFIG_ENGINE_RECONCILE_INTERVAL_MS=60000
CONFIG_ENGINE_ANOMALY_INTERVAL_MS=300000
CONFIG_ENGINE_PRUNE_KEEP=100
CONFIG_WATCHER_DEBOUNCE_MS=500
INTEGRATION_TIMEOUT_MS=30000

# ============================================
# Miscellaneous
# ============================================
VPS_HOST=102.208.228.44
REPO_PATH=/var/www/bridgeai
GATEWAY_PATH=/
NETWORK_MODE=production
DEMO_MODE=false
SHADOW=false
HTTPS=true
SERVERLESS=false
PROMPT_ENGINE_MODE=standard
ADVISOR_PROVIDER=anthropic
ADVISOR_SHARED_SECRET=change-this-advisor-secret
YOUTUBE_API_KEY=
ZAPIER_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
CONTAINERX_TOKEN=
NEXT_PUBLIC_BASE_URL=https://go.ai-os.co.za
GRAPH_SERVICE_HOST=127.0.0.1
GRAPH_SERVICE_PORT=8500
